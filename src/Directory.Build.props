<Project>
  <Import Project="../Directory.Build.props"/>
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerAutoIncrement>minor</MinVerAutoIncrement>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Authors>duskembayev</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/duskembayev/Enhanced.Testing.Component</RepositoryUrl>
    <PackageProjectUrl>https://github.com/duskembayev/Enhanced.Testing.Component</PackageProjectUrl>
    <PackageTags>integration-testing;component-testing;testing;aspnetcore;testcontainers;webapplicationfactory;xunit;harness</PackageTags>
    <PackageIcon>icons/icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageDescription>Integration (component) tests for ASP.NET Core: the application runs in memory through WebApplicationFactory, and its real dependencies (PostgreSQL, Kafka, Redis) run in Docker through Testcontainers.</PackageDescription>
  </PropertyGroup>

  <PropertyGroup>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(PackageValidationBaselineVersion)' != ''">
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="SetAssemblyVersionFromMinVer" AfterTargets="MinVer">
    <PropertyGroup>
      <AssemblyVersion>$(MinVerMajor).$(MinVerMinor).$(MinVerPatch).0</AssemblyVersion>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\images\icon.png" Pack="true" PackagePath="icons"/>
    <None Include="$(MSBuildProjectDirectory)\README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>
</Project>
