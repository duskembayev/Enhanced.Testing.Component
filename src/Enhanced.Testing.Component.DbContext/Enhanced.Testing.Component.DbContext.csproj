<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageTags>$(PackageTags);efcore;entity-framework-core;dbcontext</PackageTags>
    <PackageDescription>EF Core schema creation and access to the application's database for integration (component) tests of ASP.NET Core applications. Part of Enhanced.Testing.Component.</PackageDescription>
  </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Enhanced.Testing.Component\Enhanced.Testing.Component.csproj" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
      <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.34" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
      <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.23" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
      <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
      <PackageReference Include="Microsoft.EntityFrameworkCore" Version="11.0.0" />
    </ItemGroup>

</Project>
